---
/**
 * Explanatory sequence for the thesis analysis.
 * Labels restate the approved order of work. They are not results.
 */
const steps = [
  'CRISPR screen analysis',
  'Candidate-gene prioritization',
  'Pathway interpretation',
];
---

<figure class="method-schematic">
  <ol class="method-flow">
    {steps.map((step, index) => (
      <li>
        <span class="method-index" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <span>{step}</span>
      </li>
    ))}
  </ol>
  <figcaption>
    Analysis sequence for the thesis. Prioritized candidates are not validated
    mechanisms.
  </figcaption>
</figure>

<style>
  .method-schematic {
    margin: 0 0 40px;
  }
  .method-flow {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
  }
  .method-flow li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding-top: 12px;
    border-top: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.25;
    text-wrap: balance;
  }
  .method-index {
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .method-schematic figcaption {
    margin-top: 14px;
    max-width: 62ch;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (min-width: 800px) {
    .method-flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px 28px;
    }
  }
</style>
