---
/** Standard index-page header: eyebrow label, the page's single h1, lede. */
interface Props {
  label: string;
  title: string;
  lede?: string;
}
const { label, title, lede } = Astro.props;
---

<header class="page-head">
  <p class="label">{label}</p>
  <h1 set:html={title} />
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
