---
import type { TimelineEntry, TrackId } from '../data/profile';

interface Props {
  entries: TimelineEntry[];
}
const { entries } = Astro.props;

const TRACKS: { id: TrackId; label: string }[] = [
  { id: 'education', label: 'Education' },
  { id: 'exchange', label: 'Exchange' },
  { id: 'research', label: 'Research' },
  { id: 'work', label: 'Clinical & industry' },
];

const NARROWEST_LANE_PX_PER_PERCENT = 5.4;
const LABEL_PX_PER_CHAR = 7.5;

/** Months since year 0 for a YYYY-MM string. */
const toMonths = (value: string) => {
  const [year, month] = value.split('-').map(Number);
  return year! * 12 + (month! - 1);
};
const now = new Date();
const nowMonths = now.getUTCFullYear() * 12 + now.getUTCMonth();
const firstYear = Math.min(
  ...entries.map((entry) => Number(entry.start.slice(0, 4))),
);
const lastYear = now.getUTCFullYear() + 1;
const domainStart = firstYear * 12;
const span = lastYear * 12 - domainStart;
const percent = (months: number) => ((months - domainStart) / span) * 100;
const latest = [...entries].sort((a, b) => b.start.localeCompare(a.start))[0];

const years = Array.from(
  { length: lastYear - firstYear },
  (_, index) => firstYear + index,
);
const tracks = TRACKS.map((track) => ({
  ...track,
  features: entries
    .filter((entry) => entry.track === track.id)
    .map((entry) => {
      const start = toMonths(entry.start);
      // An end month is inclusive, so the feature runs to the start of the next one.
      const end = entry.end ? toMonths(entry.end) + 1 : nowMonths + 1;
      const left = percent(start);
      const width = percent(end) - left;
      // Label placement, sized against the narrowest lane the track is drawn at.
      const room = width * NARROWEST_LANE_PX_PER_PERCENT;
      const fits = (text: string) =>
        text.length * LABEL_PX_PER_CHAR + 18 < room;
      const inside = fits(entry.title) || fits(entry.short);
      return {
        entry,
        ongoing: !entry.end,
        left,
        width,
        text: fits(entry.title) ? entry.title : entry.short,
        placement: inside ? 'inside' : left > 60 ? 'before' : 'after',
      };
    }),
})).filter((track) => track.features.length > 0);
let order = 0;
---

<figure class="track" data-first-year={firstYear} data-last-year={lastYear}>
  <figcaption class="track-caption">
    Education, research, and work on one time axis, {firstYear} to the present.
    Select a feature to jump to its entry.
  </figcaption>
  <div class="track-scroll">
    <div class="track-canvas">
      <div class="track-row track-axis" aria-hidden="true">
        <span class="track-name">Year</span>
        <div class="track-lane">
          {years.map((year) => (
            <span
              class="track-tick"
              style={`left:${percent(year * 12).toFixed(3)}%`}
            >
              {year}
            </span>
          ))}
        </div>
      </div>
      {tracks.map((track) => (
        <div class="track-row">
          <span class="track-name">{track.label}</span>
          <div class="track-lane">
            {track.features.map(
              ({ entry, ongoing, left, width, text, placement }) => (
                <a
                  class:list={[
                    'track-feature',
                    `label-${placement}`,
                    { 'is-ongoing': ongoing },
                  ]}
                  href={`#${entry.id}`}
                  data-entry={entry.id}
                  data-readout={`${entry.title} · ${entry.institution} · ${entry.period}`}
                  style={`left:${left.toFixed(3)}%;width:${width.toFixed(3)}%;--i:${order++}`}
                >
                  <span class="track-feature-label">{text}</span>
                  <span class="sr-only">
                    : {entry.title}, {entry.institution}, {entry.period}
                  </span>
                </a>
              ),
            )}
          </div>
        </div>
      ))}
      <div class="track-cursor" aria-hidden="true" hidden>
        <span></span>
      </div>
    </div>
  </div>
  <p class="track-readout" aria-hidden="true">
    {latest ? `${latest.title} · ${latest.institution} · ${latest.period}` : ''}
  </p>
</figure>

<style>
  /* Genome-browser career track. Owned entirely by this component. */
  .track {
    margin-block: 34px 8px;
  }
  .track-caption {
    font-size: 14.5px;
    color: var(--muted);
    max-width: 70ch;
    margin-bottom: 14px;
  }
  .track-scroll {
    overflow-x: auto;
    border-block: 1px solid var(--rule-strong);
  }
  .track-canvas {
    position: relative;
    min-width: 660px;
  }
  .track-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    align-items: center;
    border-top: 1px solid var(--rule);
  }
  .track-axis {
    border-top: 0;
    background: var(--surface-2);
  }
  .track-name {
    position: sticky;
    left: 0;
    z-index: 2;
    align-self: stretch;
    display: flex;
    align-items: center;
    padding-right: 16px;
    background: var(--paper);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--muted);
  }
  .track-axis .track-name {
    padding-left: 10px;
    background: var(--surface-2);
  }
  .track-lane {
    position: relative;
    height: 46px;
    border-left: 1px solid var(--rule-strong);
  }
  .track-axis .track-lane {
    height: 30px;
  }
  .track-tick {
    position: absolute;
    top: 0;
    height: 30px;
    padding-left: 6px;
    border-left: 1px solid var(--rule-strong);
    font-size: 12px;
    line-height: 30px;
    color: var(--muted);
  }
  .track-tick:first-child {
    border-left: 0;
  }
  .track-feature {
    position: absolute;
    top: 8px;
    height: 30px;
    min-width: 12px;
    display: flex;
    align-items: center;
    border: 1px solid var(--accent);
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--ink);
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    transform-origin: left center;
  }
  .track-feature.is-ongoing {
    border-right-style: dashed;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
  }
  .track-feature-label {
    min-width: 0;
    padding-inline: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .label-before .track-feature-label,
  .label-after .track-feature-label {
    position: absolute;
    overflow: visible;
    color: var(--ink-soft);
  }
  .label-before .track-feature-label {
    right: 100%;
  }
  .label-after .track-feature-label {
    left: 100%;
  }
  .track-feature:hover,
  .track-feature:focus-visible {
    background: var(--accent);
    color: var(--button-ink);
    z-index: 1;
  }
  .track-cursor {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--accent);
    pointer-events: none;
  }
  .track-cursor span {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 1px 6px;
    border-radius: 3px;
    background: var(--accent);
    color: var(--button-ink);
    font-size: 11px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .track-readout {
    min-height: 1.7em;
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .track-readout.is-live {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .track-feature {
      animation: feature-in 560ms var(--ease) both;
      animation-delay: calc(var(--i, 0) * 60ms + 120ms);
    }
    @keyframes feature-in {
      from {
        transform: scaleX(0);
      }
    }
  }
</style>
<script>
  const MONTHS = [
    'Jan',
    'Feb',
    'Mar',
    'Apr',
    'May',
    'Jun',
    'Jul',
    'Aug',
    'Sep',
    'Oct',
    'Nov',
    'Dec',
  ];
  for (const track of document.querySelectorAll<HTMLElement>('.track')) {
    const readout = track.querySelector<HTMLElement>('.track-readout')!;
    const idle = readout.textContent ?? '';
    const features = track.querySelectorAll<HTMLElement>('.track-feature');
    const record = (feature: HTMLElement) =>
      document.getElementById(feature.dataset.entry ?? '');

    // A feature and its written record light up together.
    for (const feature of features) {
      const activate = () => {
        readout.textContent = feature.dataset.readout ?? idle;
        readout.classList.add('is-live');
        record(feature)?.classList.add('is-active');
      };
      const release = () => {
        readout.textContent = idle;
        readout.classList.remove('is-live');
        record(feature)?.classList.remove('is-active');
      };
      feature.addEventListener('pointerenter', activate);
      feature.addEventListener('focus', activate);
      feature.addEventListener('pointerleave', release);
      feature.addEventListener('blur', release);
    }

    // On narrow screens the lanes scroll; open at the most recent years.
    const scroller = track.querySelector<HTMLElement>('.track-scroll')!;
    scroller.scrollLeft = scroller.scrollWidth;

    // A position cursor reads out the month under the pointer, as a genome browser would.
    const canvas = track.querySelector<HTMLElement>('.track-canvas')!;
    const lane = track.querySelector<HTMLElement>('.track-lane')!;
    const cursor = track.querySelector<HTMLElement>('.track-cursor')!;
    const label = cursor.querySelector('span')!;
    const firstYear = Number(track.dataset.firstYear);
    const months = (Number(track.dataset.lastYear) - firstYear) * 12;
    canvas.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const box = lane.getBoundingClientRect();
      const ratio = (event.clientX - box.left) / box.width;
      if (ratio < 0 || ratio > 1) {
        cursor.hidden = true;
        return;
      }
      const month = Math.min(months - 1, Math.floor(ratio * months));
      cursor.hidden = false;
      cursor.style.left = `${event.clientX - canvas.getBoundingClientRect().left}px`;
      label.textContent = `${MONTHS[month % 12]} ${firstYear + Math.floor(month / 12)}`;
    });
    canvas.addEventListener('pointerleave', () => {
      cursor.hidden = true;
    });
  }
</script>
