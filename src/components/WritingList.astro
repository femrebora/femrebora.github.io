---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  articles: CollectionEntry<'writing'>[];
  /** Homepage: one lead article and at most three others. */
  featured?: boolean;
  /** Archive empty state must not link to itself or repeat the RSS link. */
  context?: 'home' | 'archive';
}
const { articles, featured = false, context = 'archive' } = Astro.props;
const lead = featured
  ? (articles.find((article) => article.data.featured) ?? articles[0])
  : undefined;
const listed = featured
  ? articles.filter((article) => article !== lead).slice(0, 3)
  : articles;
---

{articles.length ? (
  <>
    {featured && lead && (
      <article class="post-featured">
        <div class="post-date">
          <time datetime={lead.data.publishedDate.toISOString()}>
            {formatDate(lead.data.publishedDate)}
          </time>
          <span>{readingTime(lead.body)} min read</span>
        </div>
        <div>
          <span class="label label-muted">{lead.data.category}</span>
          <h3>
            <a href={`/blog/${lead.id}/`}>{lead.data.title}</a>
          </h3>
          <p class="lede">{lead.data.description}</p>
          <div class="record-actions">
            <a class="link-arrow" href={`/blog/${lead.id}/`}>
              Read the article <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </article>
    )}
    {listed.length > 0 && (
      <ol class="post-list">
        {listed.map((post) => (
          <li>
            <div class="post-date">
              <time datetime={post.data.publishedDate.toISOString()}>
                {formatDate(post.data.publishedDate)}
              </time>
              <span>{readingTime(post.body)} min read</span>
            </div>
            <div>
              <span class="label label-muted">{post.data.category}</span>
              <h3>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
            </div>
            <span class="list-arrow" aria-hidden="true">
              <Icon name="arrow-right" />
            </span>
          </li>
        ))}
      </ol>
    )}
  </>
) : context === 'archive' ? (
  <p class="quiet-note">
    No articles published yet. Essays and notes on genomics, bioinformatics, and
    the tools I use will appear here.
  </p>
) : (
  <p class="quiet-note">
    I am preparing the first pieces: essays and notes on genomics,
    bioinformatics, and the tools I use. They will appear here as they are
    published.
  </p>
)}
