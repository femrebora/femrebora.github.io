---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/content';
import Icon from './Icon.astro';
interface Props {
  articles: CollectionEntry<'writing'>[];
  /** Homepage: one lead article and at most three others. */
  featured?: boolean;
  /** Archive empty state must not link to itself. */
  context?: 'home' | 'archive';
}
const { articles, featured = false, context = 'archive' } = Astro.props;
const lead = featured
  ? (articles.find((article) => article.data.featured) ?? articles[0])
  : undefined;
const listed = featured
  ? articles.filter((article) => article !== lead).slice(0, 3)
  : articles;
---

{articles.length ? (
  <>
    {featured && lead && (
      <article class="post-featured">
        <div class="post-date">
          <time datetime={lead.data.publishedDate.toISOString()}>
            {formatDate(lead.data.publishedDate)}
          </time>
          <span>{readingTime(lead.body)} min read</span>
        </div>
        <div>
          <span class="label">
            {lead.data.featured ? 'Featured writing' : 'Latest writing'} ·{' '}
            {lead.data.category}
          </span>
          <h3>
            <a href={`/blog/${lead.id}/`} lang={lead.data.language}>
              {lead.data.title}
            </a>
          </h3>
          <p class="lede">{lead.data.description}</p>
          <div class="record-actions">
            <a class="link-arrow" href={`/blog/${lead.id}/`}>
              Read the article <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </article>
    )}
    {listed.length > 0 && (
      <>
        {featured && <h3 class="latest-heading">Latest writing</h3>}
        <ol
          class="post-list"
          id={context === 'archive' ? 'writing-results' : undefined}
        >
          {listed.map((post) => (
            <li
              data-category={post.data.category}
              data-tags={JSON.stringify(post.data.tags)}
              data-search={[
                post.data.title,
                post.data.description,
                ...post.data.tags,
              ].join(' ')}
            >
              <div class="post-date">
                <time datetime={post.data.publishedDate.toISOString()}>
                  {formatDate(post.data.publishedDate)}
                </time>
                <span>{readingTime(post.body)} min read</span>
              </div>
              <div>
                <span class="label label-muted">{post.data.category}</span>
                <h3>
                  <a href={`/blog/${post.id}/`} lang={post.data.language}>
                    {post.data.title}
                  </a>
                </h3>
                <p>{post.data.description}</p>
              </div>
              <span class="list-arrow" aria-hidden="true">
                <Icon name="arrow-right" />
              </span>
            </li>
          ))}
        </ol>
      </>
    )}
  </>
) : context === 'archive' ? (
  <p class="quiet-note">No articles published yet.</p>
) : (
  <div class="writing-empty">
    <p class="quiet-note">No articles published yet.</p>
  </div>
)}
