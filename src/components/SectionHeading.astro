---
import Icon from './Icon.astro';
interface Props {
  title: string;
  id?: string;
  href?: string;
  link?: string;
  note?: string;
}
const { title, id, href, link, note } = Astro.props;
---

<div class="section-head">
  <h2 class="section-title" id={id}>
    {title}
  </h2>
  {href ? (
    <a class="link-arrow" href={href}>
      {link} <Icon name="arrow-right" />
    </a>
  ) : note ? (
    <span class="section-note">{note}</span>
  ) : null}
</div>
