---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  image?: { src: string; alt: string };
  article?: { published: Date; updated?: Date; tags: string[] };
  noindex?: boolean;
  lang?: string;
}
const {
  title,
  description = profile.description,
  canonicalURL,
  image = {
    src: '/social-card.png',
    alt: 'F. Emre Bora: Genetics, Bioinformatics, Computational Biology',
  },
  article,
  noindex = false,
  lang = 'en',
} = Astro.props;
const pageTitle = title
  ? `${title} | ${profile.name}`
  : `${profile.name} | Writing & Bioinformatics`;
const canonical = canonicalURL || new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image.src, Astro.site).href;
const person = {
  '@type': 'Person',
  '@id': `${Astro.site}#person`,
  name: profile.fullName,
  alternateName: profile.name,
  url: Astro.site?.href,
  sameAs: [profile.github, profile.linkedin, profile.medium].filter(Boolean),
};
const structured = {
  '@context': 'https://schema.org',
  '@graph': [
    person,
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      name: profile.name,
      url: Astro.site?.href,
      description,
    },
    ...(article
      ? [
          {
            '@type': 'BlogPosting',
            headline: title,
            description,
            datePublished: article.published.toISOString(),
            ...(article.updated
              ? { dateModified: article.updated.toISOString() }
              : {}),
            author: { '@id': person['@id'] },
            mainEntityOfPage: canonical,
            image: socialImage,
            keywords: article.tags.join(', '),
            inLanguage: lang,
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf9f6" />
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        document.documentElement.dataset.theme = ['light', 'dark'].includes(
          theme,
        )
          ? theme
          : 'light';
        document.querySelector('meta[name="theme-color"]').content =
          document.documentElement.dataset.theme === 'dark'
            ? '#1c1f1d'
            : '#faf9f6';
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`Writing | ${profile.name}`}
      href={profile.rss}
    />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={image.alt} />
    {article && (
      <>
        <meta
          property="article:published_time"
          content={article.published.toISOString()}
        />
        {article.updated && (
          <meta
            property="article:modified_time"
            content={article.updated.toISOString()}
          />
        )}
      </>
    )}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structured).replace(/</g, '\\u003c')}
    />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">
      Skip to content
    </a>
    <div class="site">
      <Header />
      <main id="main" tabindex="-1" class="main">
        <div class="wrap">
          <slot />
        </div>
      </main>
      <Footer />
    </div>
  </body>
</html>
