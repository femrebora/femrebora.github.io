---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import TagList from '../../components/TagList.astro';
import MethodSchematic from '../../components/MethodSchematic.astro';
import Icon from '../../components/Icon.astro';
import { getResearch, getWriting, formatDate } from '../../lib/content';
export async function getStaticPaths() {
  return (await getResearch()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'research'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const writing = await getWriting();
const related = entry.data.relatedWriting
  .map((slug) => writing.find((post) => post.id === slug))
  .filter((post): post is CollectionEntry<'writing'> => Boolean(post));
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="detail-shell">
    <BackLink href="/research/" label="Research" />
    <header class="page-head detail-heading">
      <p class="label">
        {entry.data.kind} / {entry.data.status}
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <TagList tags={entry.data.tags} />
    </header>
    <div class="record-bar">
      {entry.data.question && (
        <div>
          <span class="label">Question</span>
          <p>{entry.data.question}</p>
        </div>
      )}
      {entry.data.role && (
        <div>
          <span class="label">Role</span>
          <p>{entry.data.role}</p>
        </div>
      )}
      {entry.data.institution && (
        <div>
          <span class="label">Institution</span>
          <p>{entry.data.institution}</p>
        </div>
      )}
      {entry.data.period && (
        <div>
          <span class="label">Period</span>
          <p>{entry.data.period}</p>
        </div>
      )}
      {entry.data.methods.length > 0 && (
        <div>
          <span class="label">Methods</span>
          <ul>
            {entry.data.methods.map((method) => (
              <li>{method}</li>
            ))}
          </ul>
        </div>
      )}
      {entry.data.links.length > 0 && (
        <div>
          <span class="label">Links</span>
          {entry.data.links.map((link) => (
            <a class="link-arrow" href={link.url}>
              {link.title} <Icon name="external" />
            </a>
          ))}
        </div>
      )}
    </div>
    {entry.data.methods.length > 0 && <MethodSchematic />}
    <article class="prose">
      <Content />
    </article>
    {related.length > 0 && (
      <section class="article-related" aria-labelledby="related-writing">
        <h2 id="related-writing">Related writing</h2>
        <ul>
          {related.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`}>
                {post.data.title}
                <span class="meta">
                  · {formatDate(post.data.publishedDate)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>
