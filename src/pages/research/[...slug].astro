---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getResearch } from '../../lib/content';
export async function getStaticPaths() {
  return (await getResearch()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'research'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="page detail-shell">
    <div class="page-narrow">
      <a class="back-link" href="/research/">
        <Icon name="arrow-left" /> Research
      </a>
      <header class="page-head detail-heading">
        <p class="label">
          {entry.data.kind} / {entry.data.status}
        </p>
        <h1>{entry.data.title}</h1>
        <p class="lede">{entry.data.description}</p>
        <p class="tag-list">
          {entry.data.tags.map((tag) => (
            <span>{tag}</span>
          ))}
        </p>
      </header>
      <div class="record-bar">
        <div>
          <span class="label">Methods</span>
          <ul>
            {entry.data.methods.map((method) => (
              <li>{method}</li>
            ))}
          </ul>
        </div>
        {entry.data.links.length > 0 && (
          <div>
            <span class="label">Links</span>
            {entry.data.links.map((link) => (
              <a class="link-arrow" href={link.url}>
                {link.title} <Icon name="external" />
              </a>
            ))}
          </div>
        )}
      </div>
      <article class="prose">
        <Content />
      </article>
    </div>
  </div>
</BaseLayout>
