---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WritingList from '../../components/WritingList.astro';
import Icon from '../../components/Icon.astro';
import { interests } from '../../data/profile';
import { getResearch, getWriting } from '../../lib/content';
const entries = await getResearch();
const related = (await getWriting())
  .filter((post) =>
    post.data.tags.some((tag) =>
      /genom|crispr|cancer|bioinformatic|research/i.test(tag),
    ),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Research"
  description="Research interests and graduate research in bioinformatics, CRISPR/Cas9 screening, cancer metabolism, and glioblastoma."
>
  <header class="page-head">
    <p class="label">Research / Areas of inquiry</p>
    <h1>
      Biological questions, <em>computational perspectives.</em>
    </h1>
    <p class="lede">
      My interests connect genetics and genomics with computational analysis,
      particularly in cancer biology and functional genetic screens.
    </p>
  </header>

  <section class="feature" id="interests" aria-labelledby="interests-title">
    <div class="feature-grid">
      <div class="feature-label">
        <h2 id="interests-title">Areas of inquiry</h2>
        <p class="meta">Research interests</p>
      </div>
      <ul class="interest-grid">
        {interests.map((interest) => (
          <li>
            <h3>{interest.title}</h3>
            <p>{interest.description}</p>
            <p class="interest-topics">{interest.topics.join(' · ')}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="feature" aria-labelledby="records-title">
    <div class="feature-grid">
      <div class="feature-label">
        <h2 id="records-title">Research records</h2>
        <p class="meta">Completed &amp; current work</p>
      </div>
      <div>
        {entries.map((entry) => (
          <article class="record">
            <div class="record-head">
              <span class="label">{entry.data.kind}</span>
              <span class="record-status">{entry.data.status}</span>
            </div>
            <h3 class="record-title">
              <a href={`/research/${entry.id}/`}>
                {entry.data.title} <Icon name="arrow-right" />
              </a>
            </h3>
            <p class="record-desc">{entry.data.description}</p>
            <dl class="meta-grid">
              {entry.data.role && (
                <div>
                  <dt>Role</dt>
                  <dd>{entry.data.role}</dd>
                </div>
              )}
              {entry.data.methods.length > 0 && (
                <div>
                  <dt>Methods</dt>
                  <dd>{entry.data.methods.join(' · ')}</dd>
                </div>
              )}
              {entry.data.tags.length > 0 && (
                <div>
                  <dt>Topics</dt>
                  <dd>{entry.data.tags.join(' · ')}</dd>
                </div>
              )}
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="feature" aria-labelledby="methods-title">
    <div class="feature-grid">
      <div class="feature-label">
        <h2 id="methods-title">Methods &amp; approaches</h2>
      </div>
      <div>
        <p class="lede lede-wide">
          My graduate work combined pooled CRISPR/Cas9 screen analysis with
          MAGeCK RRA, pathway enrichment, and integration of transcriptomic,
          metabolomic, and TCGA-GBM data.
        </p>
        <p class="meta method-note">
          Detailed methods, analysis materials, and research outputs will be
          added as they become available for sharing. Screen-derived candidates
          require validation before they can support conclusions about
          biological mechanisms.
        </p>
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="feature" aria-labelledby="related-title">
      <div class="feature-grid">
        <div class="feature-label">
          <h2 id="related-title">Related writing</h2>
        </div>
        <div>
          <WritingList articles={related} />
        </div>
      </div>
    </section>
  )}
</BaseLayout>
