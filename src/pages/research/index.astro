---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ResearchNotes from '../../components/ResearchNotes.astro';
import WritingList from '../../components/WritingList.astro';
import Icon from '../../components/Icon.astro';
import { interests } from '../../data/profile';
import { getResearch, getWriting } from '../../lib/content';
const entries = await getResearch();
const relevant = (await getWriting())
  .filter((post) =>
    post.data.tags.some((tag) =>
      /genom|research|crispr|cancer|bioinformatic/i.test(tag),
    ),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Research"
  description="Research interests and graduate research in bioinformatics, CRISPR/Cas9 screening, cancer metabolism, and glioblastoma."
>
  <div class="page">
    <div class="page-inner">
      <header class="page-head">
        <p class="label">Research / Areas of inquiry</p>
        <h1>
          Biological questions. <em>Computational perspectives.</em>
        </h1>
        <p class="lede">
          My research interests connect genetics and genomics with computational
          analysis, particularly in cancer biology and functional genetic
          screens.
        </p>
      </header>

      <section class="section" id="interests" aria-labelledby="interests-title">
        <SectionHeading
          id="interests-title"
          title="Areas of inquiry"
          note="A few questions that connect my work"
        />
        {interests.map((interest) => (
          <article class="record">
            <div class="record-head">
              <span class="label">Research interest</span>
            </div>
            <h3 class="record-title">{interest.title}</h3>
            <p class="record-desc">{interest.description}</p>
            <p class="tag-list">
              {interest.topics.map((topic) => (
                <span>{topic}</span>
              ))}
            </p>
          </article>
        ))}
      </section>

      <section class="section" aria-labelledby="focus-title">
        <SectionHeading id="focus-title" title="Research records" />
        {entries.map((entry) => (
          <article class="record">
            <div class="record-head">
              <span class="label">{entry.data.kind}</span>
              <span class="record-status">{entry.data.status}</span>
            </div>
            <h3 class="record-title">
              <a href={`/research/${entry.id}/`}>
                {entry.data.title} <Icon name="arrow-right" />
              </a>
            </h3>
            <p class="record-desc">{entry.data.description}</p>
            <dl class="meta-grid">
              <div>
                <dt>Methods</dt>
                <dd>{entry.data.methods.join(' · ')}</dd>
              </div>
              <div>
                <dt>Topics</dt>
                <dd>{entry.data.tags.join(' · ')}</dd>
              </div>
            </dl>
          </article>
        ))}
      </section>

      <section class="section" aria-labelledby="methods-title">
        <SectionHeading id="methods-title" title="Methods & approaches" />
        <p class="lede">
          My graduate work combined pooled CRISPR/Cas9 screen analysis with
          MAGeCK RRA, pathway enrichment, and integration of transcriptomic,
          metabolomic, and TCGA-GBM data.
        </p>
        <p class="meta method-note">
          Detailed methods, analysis materials, and research outputs will be
          added as they become available for sharing. Screen-derived candidates
          require validation before they can support conclusions about
          biological mechanisms.
        </p>
      </section>

      <ResearchNotes />

      {relevant.length > 0 && (
        <section class="section" aria-labelledby="related-title">
          <SectionHeading id="related-title" title="Related writing" />
          <WritingList articles={relevant} />
        </section>
      )}
    </div>
  </div>
</BaseLayout>
