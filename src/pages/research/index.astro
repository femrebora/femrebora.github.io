---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeatureSection from '../../components/FeatureSection.astro';
import MetadataList from '../../components/MetadataList.astro';
import WritingList from '../../components/WritingList.astro';
import ResearchNotes from '../../components/ResearchNotes.astro';
import Icon from '../../components/Icon.astro';
import { interests } from '../../data/profile';
import { getResearch, getWriting } from '../../lib/content';
const entries = await getResearch();
const related = (await getWriting())
  .filter((post) =>
    post.data.tags.some((tag) =>
      /genom|crispr|cancer|bioinformatic|research/i.test(tag),
    ),
  )
  .slice(0, 3);
---

<BaseLayout
  title="Research"
  description="Research interests and graduate research in bioinformatics, CRISPR/Cas9 screening, cancer metabolism, and glioblastoma."
>
  <PageHeader
    label="Research / Areas of inquiry"
    title="Biological questions, <em>computational perspectives.</em>"
    lede="My interests connect genetics and genomics with computational analysis, particularly in cancer biology and functional genetic screens."
  />

  <FeatureSection
    id="interests"
    title="Areas of inquiry"
    kicker="Research interests"
  >
    <ul class="interest-grid">
      {interests.map((interest) => (
        <li>
          <h3>{interest.title}</h3>
          <p>{interest.description}</p>
          <p class="interest-topics">{interest.topics.join(' · ')}</p>
        </li>
      ))}
    </ul>
  </FeatureSection>

  <FeatureSection
    id="records"
    title="Research records"
    kicker="Completed & current work"
  >
    {entries.map((entry) => (
      <article class="record">
        <div class="record-head">
          <span class="label">{entry.data.kind}</span>
          <span class="record-status">{entry.data.status}</span>
        </div>
        <h3 class="record-title">
          <a href={`/research/${entry.id}/`}>
            {entry.data.title} <Icon name="arrow-right" />
          </a>
        </h3>
        <p class="record-desc">{entry.data.description}</p>
        <MetadataList
          items={[
            { label: 'Institution', value: entry.data.institution },
            { label: 'Period', value: entry.data.period },
            { label: 'Role', value: entry.data.role },
            { label: 'Methods', list: entry.data.methods },
            { label: 'Topics', list: entry.data.tags },
          ]}
        />
      </article>
    ))}
  </FeatureSection>

  <FeatureSection id="methods" title="Methods & approaches">
    <p class="lede lede-wide">
      My graduate work combined pooled CRISPR/Cas9 screen analysis with MAGeCK
      RRA, pathway enrichment, and integration of transcriptomic, metabolomic,
      and TCGA-GBM data.
    </p>
    <p class="meta method-note">
      Screen-derived candidates require experimental validation before they can
      support conclusions about biological mechanisms.
    </p>
  </FeatureSection>

  <ResearchNotes />

  {related.length > 0 && (
    <FeatureSection id="related" title="Related writing">
      <WritingList articles={related} />
    </FeatureSection>
  )}
</BaseLayout>
