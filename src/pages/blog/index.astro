---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WritingList from '../../components/WritingList.astro';
import { getWriting } from '../../lib/content';
const articles = await getWriting();
const categories = [...new Set(articles.map((post) => post.data.category))];
const tags = [...new Set(articles.flatMap((post) => post.data.tags))].sort();
const showCategories = articles.length > 1 && categories.length > 1;
const showTags = articles.length > 1 && tags.length > 1;
const showFilters = showCategories || showTags;
---

<BaseLayout
  title="Writing"
  description="Notes and essays on bioinformatics, genomics, research, scientific computing, and software."
>
  <PageHeader
    label="Writing / Notes & essays"
    title="Working through ideas. <em>Writing them down.</em>"
    lede="Notes and essays on bioinformatics, genomics, research, and the tools that support it."
  />
  {showFilters && (
    <form class="writing-filters" hidden>
      {showCategories && (
        <div>
          <label for="category">Category</label>
          <select id="category">
            <option value="">All categories</option>
            {categories.map((category) => (
              <option value={category}>{category}</option>
            ))}
          </select>
        </div>
      )}
      {showTags && (
        <div>
          <label for="tag">Topic</label>
          <select id="tag">
            <option value="">All topics</option>
            {tags.map((tag) => (
              <option value={tag}>{tag}</option>
            ))}
          </select>
        </div>
      )}
      <p id="filter-status" role="status" aria-live="polite">
        {articles.length} {articles.length === 1 ? 'article' : 'articles'}
      </p>
    </form>
  )}
  <section class="writing-index" aria-label="Articles">
    <WritingList articles={articles} context="archive" />
    <p class="filter-empty meta" hidden>
      No articles match these filters. Try another category or topic.
    </p>
  </section>
  {showFilters && <script
    define:vars={{
      entries: articles.map((entry) => ({
        category: entry.data.category,
        tags: entry.data.tags,
      })),
    }}
  >
    const form = document.querySelector('.writing-filters');
    if (form) {
      form.hidden = false;
      const category = document.querySelector('#category');
      const tag = document.querySelector('#tag');
      const rows = [...document.querySelectorAll('.post-list > li')];
      const update = () => {
        let count = 0;
        rows.forEach((row, i) => {
          const matches =
            (!category ||
              !category.value ||
              entries[i].category === category.value) &&
            (!tag || !tag.value || entries[i].tags.includes(tag.value));
          row.hidden = !matches;
          if (matches) count++;
        });
        const status = document.querySelector('#filter-status');
        if (status) {
          status.textContent = `${count} ${count === 1 ? 'article' : 'articles'}`;
        }
        const empty = document.querySelector('.filter-empty');
        if (empty) empty.hidden = count !== 0;
      };
      form.addEventListener('change', update);
      form.addEventListener('submit', (event) => event.preventDefault());
    }
  </script>}
</BaseLayout>
