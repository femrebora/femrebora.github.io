---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackLink from '../../components/BackLink.astro';
import Icon from '../../components/Icon.astro';
import {
  getWriting,
  getProjects,
  formatDate,
  readingTime,
  getWritingTopics,
} from '../../lib/content';
import { profile } from '../../data/profile';
export async function getStaticPaths() {
  const entries = await getWriting();
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, newer: entries[index - 1], older: entries[index + 1] },
  }));
}
interface Props {
  entry: CollectionEntry<'writing'>;
  newer?: CollectionEntry<'writing'>;
  older?: CollectionEntry<'writing'>;
}
const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
);
const allPosts = await getWriting();
const topics = getWritingTopics(allPosts).filter((topic) =>
  entry.data.tags.includes(topic.label),
);
const relatedPosts = allPosts
  .filter(
    (post) =>
      post.id !== entry.id &&
      post.data.tags.some((tag) => entry.data.tags.includes(tag)),
  )
  .slice(0, 3);
const relatedProjects = (await getProjects()).filter((project) =>
  entry.data.relatedProjects.includes(project.id),
);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalURL={entry.data.canonicalURL}
  image={entry.data.heroImage}
  lang={entry.data.language}
  article={{
    published: entry.data.publishedDate,
    updated: entry.data.updatedDate,
    tags: entry.data.tags,
  }}
>
  <div class="detail-shell article-shell">
    <BackLink href="/blog/" label="Writing" />
    <header class="page-head detail-heading article-heading">
      <p class="label">{entry.data.category}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <div class="article-byline">
        <span>{profile.name}</span>
        <time datetime={entry.data.publishedDate.toISOString()}>
          {formatDate(entry.data.publishedDate)}
        </time>
        <span>{readingTime(entry.body)} min read</span>
      </div>
      {entry.data.updatedDate && (
        <p class="updated-date">
          Updated{' '}
          <time datetime={entry.data.updatedDate.toISOString()}>
            {formatDate(entry.data.updatedDate)}
          </time>
        </p>
      )}
    </header>
    {entry.data.heroImage && (
      <figure class="article-hero">
        <img
          src={entry.data.heroImage.src}
          alt={entry.data.heroImage.alt}
          width="1200"
          height="630"
          fetchpriority="high"
        />
      </figure>
    )}
    <div class="article-body">
      {toc.length >= 4 && (
        <aside class="detail-aside">
          <nav class="toc" aria-label="Table of contents">
            <p class="label">On this page</p>
            <ol>
              {toc.map((heading) => (
                <li class:list={{ 'toc-nested': heading.depth === 3 }}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </aside>
      )}
      <div class="article-reading">
        <article class="prose">
          <Content />
          {entry.data.references.length > 0 && (
            <section aria-labelledby="references">
              <h2 id="references">References</h2>
              <ol>
                {entry.data.references.map((reference) => (
                  <li>
                    <a href={reference.url}>{reference.title}</a>
                  </li>
                ))}
              </ol>
            </section>
          )}
        </article>
        {topics.length > 0 && (
          <nav class="article-topics" aria-label="Article topics">
            <span class="label-muted">Filed under</span>
            {topics.map((topic) => (
              <a href={topic.href}>{topic.label}</a>
            ))}
          </nav>
        )}
        {(relatedPosts.length > 0 || relatedProjects.length > 0) && (
          <aside class="article-related">
            <h2>Related reading</h2>
            <ul>
              {relatedPosts.map((post) => (
                <li>
                  <a class="link-arrow" href={`/blog/${post.id}/`}>
                    {post.data.title} <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
              {relatedProjects.map((project) => (
                <li>
                  <a class="link-arrow" href={`/work/${project.id}/`}>
                    {project.data.title} <Icon name="arrow-right" />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )}
        {(older || newer) && (
          <nav class="article-pagination" aria-label="More writing">
            {older && (
              <a href={`/blog/${older.id}/`}>
                <span>← Previous article</span>
                {older.data.title}
              </a>
            )}
            {newer && (
              <a href={`/blog/${newer.id}/`}>
                <span>Next article →</span>
                {newer.data.title}
              </a>
            )}
          </nav>
        )}
      </div>
    </div>
  </div>
  <script>
    // Progressive enhancement: link each section heading. Headings keep their
    // ids (and the table of contents works) without this.
    for (const heading of document.querySelectorAll<HTMLElement>(
      '.prose h2[id], .prose h3[id], .prose h4[id]',
    )) {
      const link = document.createElement('a');
      link.href = `#${heading.id}`;
      link.className = 'heading-anchor';
      link.setAttribute('aria-label', 'Link to this section');
      link.textContent = '#';
      heading.append(link);
    }

    // Copy controls for code blocks. The button is appended outside <code>,
    // so the copied value is exactly the block's text content.
    for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
      const code = pre.querySelector('code');
      if (!code) continue;
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.replaceWith(wrapper);
      wrapper.append(pre);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code to clipboard');
      wrapper.append(button);
      const feedback = document.createElement('span');
      feedback.className = 'sr-only';
      feedback.setAttribute('role', 'status');
      wrapper.append(feedback);
      let reset: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        let copied = false;
        try {
          await navigator.clipboard.writeText(code.textContent ?? '');
          copied = true;
        } catch {
          copied = false;
        }
        button.textContent = copied ? 'Copied' : 'Copy failed';
        feedback.textContent = copied
          ? 'Code copied to clipboard.'
          : 'Could not copy. Select the code to copy it manually.';
        if (reset) clearTimeout(reset);
        reset = setTimeout(() => {
          button.textContent = 'Copy';
        }, 2000);
      });
    }
    for (const table of document.querySelectorAll<HTMLTableElement>(
      '.prose table',
    )) {
      table.tabIndex = 0;
      table.setAttribute(
        'aria-label',
        table.caption?.textContent ||
          'Data table, scroll horizontally if needed',
      );
    }
  </script>
</BaseLayout>
