---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { credentials } from '../data/profile';
---

<BaseLayout
  title="Certificates & training"
  description="Certificates and training for F. Emre Bora."
>
  <header class="page-head">
    <p class="label">Background</p>
    <h1>Certificates &amp; training</h1>
  </header>

  {credentials.length > 0 ? (
    <ul class="credential-list">
      {credentials.map((credential) => (
        <li class="credential">
          <h2>{credential.title}</h2>
          <p class="credential-meta">
            {credential.institution} · {credential.date}
          </p>
          <p>{credential.description}</p>
          {credential.preview && (
            <img
              src={credential.preview.src}
              alt={credential.preview.alt}
              loading="lazy"
              decoding="async"
            />
          )}
          {credential.credentialURL && (
            <a class="link-arrow" href={credential.credentialURL}>
              Credential link <Icon name="external" />
            </a>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="quiet-note">
      No certificates or training records are listed here yet.{' '}
      <a href="/cv/">View the CV</a> for education and experience.
    </p>
  )}
</BaseLayout>
