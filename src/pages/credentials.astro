---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { getCredentials } from '../lib/content';

const credentials = await getCredentials();
const categoryLabels: Record<string, string> = {
  certificate: 'Certificate',
  training: 'Training',
  award: 'Award',
  workshop: 'Workshop',
  professional: 'Professional credential',
};
---

<BaseLayout
  title="Certificates & training"
  description="Certificates, training, and credentials for F. Emre Bora."
>
  <PageHeader label="Background" title="Certificates &amp; training" />

  {credentials.length > 0 ? (
    <ol class="credential-list">
      {credentials.map((credential) => (
        <li class="credential">
          <p class="label">{categoryLabels[credential.data.category]}</p>
          <h2>{credential.data.title}</h2>
          <p class="credential-meta">
            {credential.data.issuer} · {credential.data.date}
            {credential.data.credentialId &&
              ` · ID ${credential.data.credentialId}`}
          </p>
          {credential.data.description && <p>{credential.data.description}</p>}
          {credential.data.image && (
            <img
              src={credential.data.image.src}
              alt={credential.data.image.alt}
              loading="lazy"
              decoding="async"
            />
          )}
          {credential.data.credentialUrl && (
            <a class="link-arrow" href={credential.data.credentialUrl}>
              Credential link <Icon name="external" />
            </a>
          )}
        </li>
      ))}
    </ol>
  ) : (
    <p class="quiet-note">
      No certificates or training records are listed here yet.{' '}
      <a href="/cv/">View the CV</a> for education and experience.
    </p>
  )}
</BaseLayout>
