---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { credentials } from '../data/profile';
---

<BaseLayout
  title="Credentials"
  description="Certificates and education evidence for F. Emre Bora, published only when approved and sanitized."
>
  <header class="page-head">
    <p class="label">Credentials / Certificates &amp; evidence</p>
    <h1>Verified credentials.</h1>
    <p class="lede">
      Certificates and education evidence are listed here once they are approved
      for publication, with sanitized documents only.
    </p>
  </header>

  {credentials.length > 0 ? (
    <ul class="credential-list">
      {credentials.map((credential) => (
        <li class="credential">
          <h2>{credential.title}</h2>
          <p class="credential-meta">
            {credential.institution} · {credential.date}
          </p>
          <p>{credential.description}</p>
          {credential.preview && (
            <img
              src={credential.preview.src}
              alt={credential.preview.alt}
              loading="lazy"
              decoding="async"
            />
          )}
          {credential.credentialURL && (
            <a class="link-arrow" href={credential.credentialURL}>
              Verify credential <Icon name="external" />
            </a>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <div class="empty-note">
      <h2>No credentials published yet.</h2>
      <p>
        Certificates and education evidence will appear here as they are
        approved and sanitized. No placeholder or unverified documents are
        shown.
      </p>
      <div class="record-actions">
        <a class="link-arrow" href="/cv/">
          View the CV <Icon name="arrow-right" />
        </a>
        <a class="link-arrow" href="/about/">
          About &amp; education <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  )}
</BaseLayout>
