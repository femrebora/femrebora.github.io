---
import BaseLayout from '../layouts/BaseLayout.astro';
import GenomeTrack from '../components/GenomeTrack.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import Icon from '../components/Icon.astro';
import {
  profile,
  experience,
  education,
  interests,
  credentials,
} from '../data/profile';

const milestones = [...education, ...experience].sort(
  (a, b) => b.start.localeCompare(a.start) || a.title.localeCompare(b.title),
);
---

<BaseLayout
  title="About"
  description="About F. Emre Bora: genetics, bioinformatics, computational research, education, and selected technical work."
>
  <header class="page-head">
    <p class="label">About</p>
    <h1>{profile.fullName}</h1>
    <p class="lede">{profile.fields}</p>
  </header>

  <section class="about-intro" aria-label="Profile">
    <div class="prose profile-bio">
      {profile.biography.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <ProfilePhoto />
  </section>

  <h2 class="subsection-title" id="milestones">
    Milestones
  </h2>
  <GenomeTrack entries={[...education, ...experience]} />
  <ol class="milestones">
    {milestones.map((entry) => (
      <li id={entry.id}>
        <span class="milestone-when">{entry.period}</span>
        <span class="milestone-what">
          <strong>
            {entry.href ? <a href={entry.href}>{entry.title}</a> : entry.title}
          </strong>
          {entry.institution && <span>{entry.institution}</span>}
        </span>
      </li>
    ))}
  </ol>
  <p class="meta">
    The full record of education, experience, skills, and languages is on the{' '}
    <a href="/cv/">CV</a>.
  </p>

  <h2 class="subsection-title">Interests</h2>
  <ul class="interest-lines">
    {interests.map((interest) => (
      <li>
        <strong>{interest.title}</strong>
        <span>{interest.description}</span>
      </li>
    ))}
  </ul>

  {credentials.length > 0 && (
    <>
      <h2 class="subsection-title">Certificates &amp; training</h2>
      <ul class="interest-lines">
        {credentials.map((credential) => (
          <li>
            <strong>{credential.title}</strong>
            <span>
              {credential.institution} · {credential.date}
            </span>
          </li>
        ))}
      </ul>
      <p class="meta">
        <a href="/credentials/">Certificates &amp; training</a>
      </p>
    </>
  )}

  <h2 class="subsection-title" id="contact">
    Contact
  </h2>
  <div class="contact-list">
    {profile.email && (
      <a class="link-arrow" href={`mailto:${profile.email}`}>
        {profile.email} <Icon name="mail" />
      </a>
    )}
    {profile.linkedin && (
      <a class="link-arrow" href={profile.linkedin}>
        LinkedIn <Icon name="external" />
      </a>
    )}
    <a class="link-arrow" href={profile.github}>
      GitHub <Icon name="external" />
    </a>
    <a class="link-arrow" href="/cv/">
      View CV <Icon name="arrow-right" />
    </a>
  </div>
</BaseLayout>
