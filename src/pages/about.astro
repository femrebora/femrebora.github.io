---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import {
  profile,
  experience,
  education,
  credentials,
  capabilities,
  languages,
} from '../data/profile';
---

<BaseLayout
  title="About & CV"
  description="About F. Emre Bora: genetics, bioinformatics, computational research, and selected technical work."
>
  <div class="page">
    <div class="page-inner">
      <header class="page-head intro">
        <div class="intro-head">
          <p class="label">About / Background & practice</p>
          <h1>{profile.name}</h1>
        </div>
        <ProfilePhoto />
        <div class="intro-body">
          <p class="lede">{profile.fields}</p>
        </div>
      </header>

      <section class="section" aria-labelledby="profile-title">
        <SectionHeading id="profile-title" title="Profile" />
        <dl class="meta-grid">
          <div>
            <dt>Role</dt>
            <dd>Bioinformatician</dd>
          </div>
          <div>
            <dt>Affiliation</dt>
            <dd>Ecegen Genetic Diseases Assessment Center</dd>
          </div>
          <div>
            <dt>Education</dt>
            <dd>MSc Biotechnology · Bezmialem Vakif University, 2026</dd>
          </div>
          <div>
            <dt>Exchange</dt>
            <dd>Erasmus exchange · Universidad de A Coruña, 2020–2021</dd>
          </div>
        </dl>
        <div class="prose profile-bio">
          <p>{profile.introduction}</p>
          {profile.biography.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </section>

      <section
        class="section"
        id="experience"
        aria-labelledby="experience-title"
      >
        <SectionHeading
          id="experience-title"
          title="Professional & research experience"
        />
        <Timeline entries={experience} />
      </section>

      <section class="section" id="education" aria-labelledby="education-title">
        <SectionHeading id="education-title" title="Education" />
        {education.length ? (
          <Timeline entries={education} />
        ) : (
          <p class="meta">
            Education details will be included with the full CV.
          </p>
        )}
      </section>

      <section class="section" id="languages" aria-labelledby="languages-title">
        <SectionHeading id="languages-title" title="Languages" />
        <dl class="language-list">
          {languages.map((language) => (
            <div>
              <dt>{language.name}</dt>
              <dd>{language.description}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="section" aria-labelledby="areas-title">
        <SectionHeading id="areas-title" title="Areas of work" />
        <div class="capabilities">
          {capabilities.map((group) => (
            <div>
              <h3>{group.domain}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <section
        class="section"
        id="credentials"
        aria-labelledby="credentials-title"
      >
        <SectionHeading id="credentials-title" title="Credentials" />
        {credentials.length ? (
          <ul class="credential-list">
            {credentials.map((credential) => (
              <li>
                <h3>{credential.title}</h3>
                <p>
                  {credential.institution} · {credential.date}
                </p>
                <p>{credential.description}</p>
                {credential.preview && (
                  <img
                    src={credential.preview.src}
                    alt={credential.preview.alt}
                    loading="lazy"
                    width="640"
                    height="450"
                  />
                )}
                {credential.credentialURL && (
                  <a class="link-arrow" href={credential.credentialURL}>
                    View credential <Icon name="external" />
                  </a>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="meta">Selected credentials will be added here.</p>
        )}
      </section>

      <section class="section" id="cv" aria-labelledby="cv-title">
        <SectionHeading id="cv-title" title="Curriculum vitae" />
        {profile.cv ? (
          <a class="button" href={profile.cv} download>
            Download CV <Icon name="download" />
          </a>
        ) : (
          <>
            <p class="lede">A downloadable CV will be available here.</p>
            <p class="meta">
              For now, explore the <a href="/research/">research overview</a>{' '}
              and
              <a href="/work/">selected work</a>.
            </p>
          </>
        )}
      </section>

      <section class="section" id="contact" aria-labelledby="contact-title">
        <SectionHeading id="contact-title" title="Elsewhere & contact" />
        <div class="contact-links">
          <a class="link-arrow" href={profile.github}>
            GitHub <Icon name="external" />
          </a>
          {profile.linkedin && (
            <a class="link-arrow" href={profile.linkedin}>
              LinkedIn <Icon name="external" />
            </a>
          )}
          {profile.email ? (
            <a class="link-arrow" href={`mailto:${profile.email}`}>
              {profile.email} <Icon name="mail" />
            </a>
          ) : (
            <p class="meta">Direct contact details will be added here.</p>
          )}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
