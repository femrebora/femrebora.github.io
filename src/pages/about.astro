---
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';
import GenomeTrack from '../components/GenomeTrack.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import Icon from '../components/Icon.astro';
import {
  profile,
  experience,
  education,
  capabilities,
  languages,
} from '../data/profile';
---

<BaseLayout
  title="About"
  description="About F. Emre Bora: genetics, bioinformatics, computational research, education, and selected technical work."
>
  <header class="page-head">
    <p class="label">About / Background &amp; practice</p>
    <h1>{profile.fullName}</h1>
    <p class="lede">{profile.fields}</p>
  </header>

  <section class="about-intro" aria-label="Profile">
    <div class="prose profile-bio">
      <p>{profile.introduction}</p>
      {profile.biography.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <ProfilePhoto />
  </section>

  <h2 class="subsection-title" id="experience">
    Professional &amp; research experience
  </h2>
  <Timeline entries={experience} />

  <h2 class="subsection-title" id="education">
    Education
  </h2>
  <Timeline entries={education} />

  <h2 class="subsection-title">Career timeline</h2>
  <p class="meta">
    A genome-browser-style view of the same periods. The lists above carry the
    full detail.
  </p>
  <GenomeTrack entries={[...education, ...experience]} />

  <h2 class="subsection-title">Areas of work</h2>
  <div class="capabilities">
    {capabilities.map((group) => (
      <div>
        <h3>{group.domain}</h3>
        <ul>
          {group.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <h2 class="subsection-title">Languages</h2>
  <dl class="language-list">
    {languages.map((language) => (
      <div>
        <dt>{language.name}</dt>
        <dd>{language.description}</dd>
      </div>
    ))}
  </dl>

  <h2 class="subsection-title" id="contact">
    Contact
  </h2>
  <div class="contact-list">
    {profile.email && (
      <a class="link-arrow" href={`mailto:${profile.email}`}>
        {profile.email} <Icon name="mail" />
      </a>
    )}
    {profile.linkedin && (
      <a class="link-arrow" href={profile.linkedin}>
        LinkedIn <Icon name="external" />
      </a>
    )}
    <a class="link-arrow" href={profile.github}>
      GitHub <Icon name="external" />
    </a>
    <a class="link-arrow" href="/cv/">
      Curriculum vitae <Icon name="arrow-right" />
    </a>
  </div>
</BaseLayout>
