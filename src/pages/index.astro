---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingList from '../components/WritingList.astro';
import WritingTopics from '../components/WritingTopics.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { getWriting, selectHomepageWriting } from '../lib/content';
const articles = await getWriting();
const homePosts = selectHomepageWriting(articles);
---

<BaseLayout>
  <div class="home-publication">
    <header class="intro">
      <div>
        <p class="label">Notes &amp; essays</p>
        <h1>{profile.name}</h1>
      </div>
      <p class="intro-lede">{profile.writingIntroduction}</p>
    </header>

    <section class="home-writing" id="blog" aria-labelledby="blog-title">
      <div class="section-head">
        <h2 id="blog-title">Writing</h2>
        <a class="link-arrow" href="/blog/">
          All writing <Icon name="arrow-right" />
        </a>
      </div>
      <WritingList articles={homePosts} featured context="home" />
      {articles.some((post) => post.data.tags.some((tag) => tag.trim())) && (
        <section class="home-topics" aria-labelledby="topics-title">
          <h3 id="topics-title">Explore by topic</h3>
          <WritingTopics articles={articles} />
        </section>
      )}
    </section>
  </div>
</BaseLayout>
