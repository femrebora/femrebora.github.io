---
import BaseLayout from '../layouts/BaseLayout.astro';
import WritingList from '../components/WritingList.astro';
import MethodSchematic from '../components/MethodSchematic.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import {
  getWriting,
  getResearch,
  getProjects,
  selectHomepageWriting,
} from '../lib/content';
const articles = await getWriting();
const homePosts = selectHomepageWriting(articles);
const hasWriting = homePosts.length > 0;
const researchEntries = await getResearch();
const research =
  researchEntries.find((entry) => entry.data.featured) ?? researchEntries[0];
const projects = await getProjects();
const project = projects.find((entry) => entry.data.featured) ?? projects[0];
---

<BaseLayout>
  <header class="intro">
    <p class="label">Bioinformatician · Genetics &amp; computational biology</p>
    <h1>{profile.name}</h1>
    <p class="lede">{profile.introduction}</p>
    <div class="hero-actions">
      <a class="button" href="#research">
        Explore research <Icon name="arrow-right" />
      </a>
      <a class="button button-secondary" href="/cv/">
        View CV <Icon name="arrow-right" />
      </a>
    </div>
  </header>

  {hasWriting && (
    <section class="home-writing" id="blog" aria-labelledby="blog-title">
      <div class="home-writing-head">
        <h2 id="blog-title">Writing</h2>
        <a class="link-arrow" href="/blog/">
          All writing <Icon name="arrow-right" />
        </a>
      </div>
      <WritingList articles={homePosts} featured context="home" />
    </section>
  )}

  {research && (
    <section
      class="home-research"
      id="research"
      aria-labelledby="research-title"
    >
      <div class="home-research-copy">
        <p class="label">{research.data.status}</p>
        <h2 id="research-title">
          <a href={`/research/${research.id}/`}>{research.data.title}</a>
        </h2>
        {research.data.question && (
          <p class="home-question">{research.data.question}</p>
        )}
      </div>
      <p class="home-research-summary">{research.data.description}</p>
      <MethodSchematic />
      <div class="record-actions">
        <a class="link-arrow" href={`/research/${research.id}/`}>
          Read the research <Icon name="arrow-right" />
        </a>
      </div>
    </section>
  )}

  {project && (
    <section class="home-work" id="work" aria-labelledby="work-title">
      {project.data.image && (
        <figure class="home-shot-figure">
          <a class="home-shot" href={`/work/${project.id}/`}>
            <img
              class="is-cropped"
              src={project.data.image.src}
              alt={project.data.image.alt}
              width={project.data.image.width}
              height={project.data.image.height}
              loading="eager"
              decoding="async"
            />
          </a>
          {project.data.image.caption && (
            <figcaption>{project.data.image.caption}</figcaption>
          )}
        </figure>
      )}
      <div class="home-work-copy">
        <p class="label">{project.data.category}</p>
        <h2 id="work-title">
          <a href={`/work/${project.id}/`}>{project.data.title}</a>
        </h2>
        <p>{project.data.description}</p>
        {project.data.stack.length > 0 && (
          <p class="meta">{project.data.stack.join(' · ')}</p>
        )}
        <div class="record-actions">
          <a class="link-arrow" href={`/work/${project.id}/`}>
            Case study <Icon name="arrow-right" />
          </a>
          {project.data.website && (
            <a class="link-arrow" href={project.data.website}>
              Visit website <Icon name="external" />
            </a>
          )}
        </div>
      </div>
    </section>
  )}

  {!hasWriting && (
    <section
      class="home-writing home-writing-quiet"
      id="blog"
      aria-labelledby="blog-title"
    >
      <h2 id="blog-title">Writing</h2>
      <p>
        Notes and essays on bioinformatics, genomics, and scientific computing.
      </p>
    </section>
  )}

  <section class="home-close" id="background">
    <div>
      <h2>About</h2>
      <p>
        Bioinformatician at Ecegen Genetic Diseases Assessment Center. MSc in
        Biotechnology, Bezmialem Vakif University, completed July 2026.
      </p>
      <a class="link-arrow" href="/about/">
        About <Icon name="arrow-right" />
      </a>
    </div>
    <div id="contact">
      <h2>Contact</h2>
      <div class="contact-list">
        {profile.email && (
          <a class="link-arrow" href={`mailto:${profile.email}`}>
            {profile.email} <Icon name="mail" />
          </a>
        )}
        {profile.linkedin && (
          <a class="link-arrow" href={profile.linkedin}>
            LinkedIn <Icon name="external" />
          </a>
        )}
        <a class="link-arrow" href={profile.github}>
          GitHub <Icon name="external" />
        </a>
        <a class="link-arrow" href={profile.cv} download>
          Download CV (PDF) <Icon name="download" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
