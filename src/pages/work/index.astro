---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeatureSection from '../../components/FeatureSection.astro';
import ProjectRecord from '../../components/ProjectRecord.astro';
import { getProjects } from '../../lib/content';
const projects = await getProjects();
---

<BaseLayout
  title="Selected work"
  description="Selected technical work in healthcare, laboratory technology, and software, including the ECEGEN website."
>
  <PageHeader
    label="Work / Software & systems"
    title="Useful systems, <em>grounded in context.</em>"
    lede="Alongside research, I build software and technical systems. This is a small selection of that work."
  />

  <FeatureSection id="projects" title="Selected projects" kicker="Case studies">
    {projects.map((project) => (
      <ProjectRecord project={project} heading="h3" />
    ))}
  </FeatureSection>
</BaseLayout>
