---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRecord from '../../components/ProjectRecord.astro';
import { getProjects } from '../../lib/content';
const projects = await getProjects();
---

<BaseLayout
  title="Selected work"
  description="Selected technical work in healthcare, laboratory technology, and software, including the ECEGEN website."
>
  <header class="page-head">
    <p class="label">Work / Software &amp; systems</p>
    <h1>
      Useful systems, <em>grounded in context.</em>
    </h1>
    <p class="lede">
      Alongside research, I build software and technical systems. This is a
      small selection of that work.
    </p>
  </header>

  <section class="feature" aria-labelledby="projects-title">
    <div class="feature-grid">
      <div class="feature-label">
        <h2 id="projects-title">Selected projects</h2>
        <p class="meta">Case studies</p>
      </div>
      <div>
        {projects.map((project) => (
          <ProjectRecord project={project} heading="h3" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
